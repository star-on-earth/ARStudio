{
  "expo": {
    "name": "AR Studio",
    "slug": "ar-studio",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#06060f",
    "android": {
      "package": "com.arstudio.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#06060f"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        { "cameraPermission": "AR Studio needs your camera for AR experiences." }
      ],
      [
        "expo-av",
        { "microphonePermission": "AR Studio needs your microphone to record videos." }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "AR Studio needs access to save your captured photos.",
          "savePhotosPermission": "AR Studio needs permission to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ]
  }
}
